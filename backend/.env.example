PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD@localhost:5432/posyandu_pintar
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGIN=http://localhost:5173
# Produksi:
# DATABASE_SSL=true        (hanya jika memakai URL eksternal yang mewajibkan SSL)
# TRUST_PROXY=1            (bila di belakang reverse proxy)
# DEMO_PASSWORD=...        (wajib saat mengisi akun demo di database publik)